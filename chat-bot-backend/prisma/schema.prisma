generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//users table
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  profile_picture  String?
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  createdAt    DateTime @default(now())
}
